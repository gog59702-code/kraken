{
  "$schema": "https://opencode.ai/config.json",
  "model": "google/gemini-3.1-flash-lite",
  "small_model": "google/gemini-3.1-flash-lite",
  "agent": {
    "build": { "model": "google/gemini-3.1-flash-lite" },
    "Jailbreak": { "model": "google/gemini-3.1-flash-lite" },
    "od": { "model": "google/gemini-3.1-flash-lite" }
  },
  "mcp": {
    "timeout": {
      "startup": 45000,
      "catalog": 60000
    },
    "servers": {
      "madium": {
        "command": [
          "\\\\?\\C:\\Users\\User\\AppData\\Local\\Madium\\MCP\\madium-mcp.exe",
          "--config",
          "C:\\Users\\User\\AppData\\Local\\Madium\\MCP\\config.json"
        ],
        "type": "local"
      },
      "browse": {
        "type": "local",
        "command": [
          "C:\\Users\\User\\.local\\bin\\browse.exe",
          "mcp"
        ],
        "cwd": "C:\\Users\\User",
        "pool": true,
        "environment": {
          "OPENCODE_BROWSER_RUNTIME": "auto-update"
        }
      },

      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "pool": true
      },
      "cloudflare-docs": {
        "type": "remote",
        "url": "https://docs.mcp.cloudflare.com/mcp",
        "pool": true
      },
      "firecrawl": {
        "type": "remote",
        "url": "https://mcp.firecrawl.dev/v2/mcp",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:FIRECRAWL_API_KEY}"
        },
        "disabled": true
      },
      "shopify": {
        "type": "remote",
        "url": "https://mcp.shopify.com",
        "pool": true
      },
      "shopify-dev": {
        "type": "local",
        "command": ["npx", "-y", "@shopify/dev-mcp@latest"],
        "cwd": "C:\\Users\\User\\ia",
        "pool": true
      },
      "filesystem": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@modelcontextprotocol/server-filesystem",
          "C:\\Users\\User\\ia",
          "C:\\Users\\User\\Desktop",
          "C:\\Users\\User\\Documents",
          "C:\\Users\\User\\Downloads"
        ],
        "cwd": "C:\\Users\\User\\ia",
        "pool": true
      },
      "playwright": {
        "type": "local",
        "command": ["npx", "-y", "@playwright/mcp@latest", "--headless"],
        "cwd": "C:\\Users\\User\\ia",
        "pool": true
      },
      "chrome-devtools": {
        "type": "local",
        "command": ["npx", "-y", "chrome-devtools-mcp@latest"],
        "cwd": "C:\\Users\\User\\ia",
        "pool": true
      },

      "vercel": {
        "type": "remote",
        "url": "https://mcp.vercel.com",
        "pool": true
      },
      "linear": {
        "type": "remote",
        "url": "https://mcp.linear.app/mcp",
        "pool": true
      },
      "notion": {
        "type": "remote",
        "url": "https://mcp.notion.com/mcp",
        "pool": true
      },
      "railway": {
        "type": "remote",
        "url": "https://mcp.railway.com/mcp",
        "pool": true
      },
      "neon": {
        "type": "remote",
        "url": "https://mcp.neon.tech/mcp",
        "pool": true
      },
      "supabase": {
        "type": "remote",
        "url": "https://mcp.supabase.com/mcp",
        "pool": true
      },
      "figma": {
        "type": "remote",
        "url": "https://mcp.figma.com/mcp",
        "pool": true
      },
      "canva": {
        "type": "remote",
        "url": "https://mcp.canva.com/mcp",
        "pool": true
      },
      "webflow": {
        "type": "remote",
        "url": "https://mcp.webflow.com/mcp",
        "pool": true
      },
      "airtable": {
        "type": "remote",
        "url": "https://mcp.airtable.com/mcp",
        "pool": true
      },
      "posthog": {
        "type": "remote",
        "url": "https://mcp.posthog.com/mcp",
        "pool": true
      },
      "calendly": {
        "type": "remote",
        "url": "https://mcp.calendly.com",
        "pool": true
      },
      "similarweb": {
        "type": "remote",
        "url": "https://mcp.similarweb.com/mcp",
        "pool": true
      },
      "windsor": {
        "type": "remote",
        "url": "https://mcp.windsor.ai/",
        "pool": true
      },
      "clickhouse": {
        "type": "remote",
        "url": "https://mcp.clickhouse.cloud/mcp",
        "pool": true
      },
      "replit": {
        "type": "remote",
        "url": "https://mcp.replit.com/server/mcp",
        "pool": true
      },
      "tinyfish": {
        "type": "remote",
        "url": "https://agent.tinyfish.ai/mcp",
        "pool": true
      },
      "metricool": {
        "type": "remote",
        "url": "https://ai.metricool.com/mcp",
        "pool": true
      },
      "cloudflare": {
        "type": "remote",
        "url": "https://mcp.cloudflare.com/mcp",
        "pool": true
      },

      "gmail": {
        "type": "remote",
        "url": "https://gmailmcp.googleapis.com/mcp/v1",
        "oauth": {
          "client_id": "{env:GOOGLE_MCP_CLIENT_ID}",
          "client_secret": "{env:GOOGLE_MCP_CLIENT_SECRET}",
          "callback_port": 19878,
          "redirect_uri": "http://127.0.0.1:19878/callback"
        },
        "disabled": true
      },
      "google-calendar": {
        "type": "remote",
        "url": "https://calendarmcp.googleapis.com/mcp/v1",
        "oauth": {
          "client_id": "{env:GOOGLE_MCP_CLIENT_ID}",
          "client_secret": "{env:GOOGLE_MCP_CLIENT_SECRET}",
          "callback_port": 19879,
          "redirect_uri": "http://127.0.0.1:19879/callback"
        },
        "disabled": true
      },
      "asana": {
        "type": "remote",
        "url": "https://mcp.asana.com/v2/mcp",
        "oauth": {
          "client_id": "{env:ASANA_CLIENT_ID}",
          "client_secret": "{env:ASANA_CLIENT_SECRET}",
          "callback_port": 19876,
          "redirect_uri": "http://127.0.0.1:19876/callback"
        },
        "disabled": true
      },
      "hubspot": {
        "type": "remote",
        "url": "https://mcp.hubspot.com",
        "oauth": {
          "client_id": "{env:HUBSPOT_CLIENT_ID}",
          "client_secret": "{env:HUBSPOT_CLIENT_SECRET}",
          "callback_port": 19877,
          "redirect_uri": "http://127.0.0.1:19877/callback"
        },
        "disabled": true
      },
      "render": {
        "type": "remote",
        "url": "https://mcp.render.com/mcp",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:RENDER_API_KEY}"
        },
        "disabled": true
      },
      "github": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:GITHUB_PAT}"
        },
        "disabled": true
      },
      "ahrefs": {
        "type": "remote",
        "url": "https://api.ahrefs.com/mcp/mcp",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:AHREFS_API_TOKEN}"
        },
        "disabled": true
      },
      "magicpath": {
        "type": "remote",
        "url": "https://api.magicpath.ai/mcp",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:MAGICPATH_API_TOKEN}"
        },
        "disabled": true
      },
      "mongodb": {
        "type": "local",
        "command": ["npx", "-y", "mongodb-mcp-server"],
        "cwd": "C:\\Users\\User\\ia",
        "environment": {
          "MDB_MCP_CONNECTION_STRING": "{env:MONGODB_URI}"
        },
        "disabled": true
      }
    }
  },
  "plugins": []
}
