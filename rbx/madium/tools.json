{
  "server": "madium",
  "updated": "2026-11-22",
  "runtime_required": true,
  "tools": [
    { "name": "runtime_status", "when": "avant toute rafale d'appels" },
    { "name": "list_runtime_clients", "when": "plusieurs clients / pid ambigu" },
    { "name": "get_client_info", "when": "contexte jeu, joueur, perf, executor" },
    { "name": "scan_runtime_capabilities", "when": "savoir quels globals existent" },
    { "name": "execute_luau", "when": "exécuter un module, capturer valeurs/erreurs" },
    { "name": "eval_luau", "when": "lire une valeur rapide" },
    { "name": "run_executor_file", "when": "script déjà sur disque executor" },
    { "name": "list_executor_files", "when": "inventaire workspace executor" },
    { "name": "read_executor_file", "when": "relire un module" },
    { "name": "write_executor_file", "when": "persister un module" },
    { "name": "list_actors", "when": "threads/coroutines actifs" },
    { "name": "tail_console", "when": "erreurs runtime, prints" },
    { "name": "inspect_instance", "when": "class, parent, attributs d'un objet" },
    { "name": "get_descendants_tree", "when": "cartographier un sous-arbre" },
    { "name": "search_instances", "when": "trouver par nom + classe" },
    { "name": "inspect_connections", "when": "qui écoute un signal" },
    { "name": "list_remotes", "when": "surface réseau du jeu" },
    { "name": "decompile_script", "when": "source d'un script live" },
    { "name": "inspect_script_bytecode", "when": "hash/taille, dump base64" },
    { "name": "search_runtime_scripts", "when": "lister les scripts chargés" },
    { "name": "search_gc", "when": "retrouver une fonction/table en GC" },
    { "name": "list_environment_libraries", "when": "index de la doc bundled" },
    { "name": "get_environment_library", "when": "toute une lib" },
    { "name": "search_environment_api", "when": "chercher une fonction/alias" },
    { "name": "get_environment_function", "when": "signature + exemple" },
    { "name": "inspect_environment_function", "when": "comportement réel d'une fonction" },
    { "name": "probe_callback_context", "when": "identité de coroutine, traceback" },
    { "name": "search_globals", "when": "explorer les globals executor" },
    { "name": "inspect_visible_ui", "when": "inventaire GUI visible" },
    { "name": "click_gui_button", "when": "activation bouton" },
    { "name": "type_into_textbox", "when": "remplir un champ" },
    { "name": "send_input", "when": "une touche/souris" },
    { "name": "list_ui_libraries", "when": "catalogue UI" },
    { "name": "search_ui_libraries", "when": "filtrer par feature/statut" },
    { "name": "get_ui_library", "when": "détails + source" },
    { "name": "install_ui_library", "when": "installer sans exécuter" },
    { "name": "set_runtime_setting", "when": "régler le module" }
  ],
  "recipes": {
    "recon": ["runtime_status", "get_client_info", "get_descendants_tree", "list_remotes", "search_runtime_scripts"],
    "remote_spy": ["list_remotes", "inspect_connections", "execute_luau:remote_spy.luau", "tail_console"],
    "decompile": ["search_runtime_scripts", "decompile_script", "inspect_script_bytecode"],
    "dev_loop": ["execute_luau", "tail_console", "write_executor_file", "run_executor_file"],
    "ui_abuse": ["inspect_visible_ui", "click_gui_button", "type_into_textbox", "send_input"],
    "hook_check": ["search_gc", "probe_callback_context", "inspect_environment_function"]
  },
  "rules": [
    "runtime_status avant une rafale",
    "capture:true interdit sur script resident",
    "timeout 10s defaut, 60s max",
    "chemins en notation point",
    "deux echecs = mauvais chemin ou client deconnecte"
  ]
}
